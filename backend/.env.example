# Banco de dados PostgreSQL
# Formato: postgres://usuario:senha@host:porta/banco?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financas_familiares?sslmode=disable

# Segredo para assinatura dos JWTs — use uma string longa e aleatória em produção
# Exemplo: openssl rand -hex 32
JWT_SECRET=troque-por-segredo-aleatorio-longo-em-producao

# Porta do servidor HTTP (padrão: 8080)
SERVER_PORT=8080

# Dados dos usuários iniciais (seed)
# As senhas serão hasheadas com bcrypt (custo 12) pelo backend
SEED_USER1_EMAIL=usuario1@familia.com
SEED_USER1_NOME=Membro Um
SEED_USER1_SENHA=senha-segura-1

SEED_USER2_EMAIL=usuario2@familia.com
SEED_USER2_NOME=Membro Dois
SEED_USER2_SENHA=senha-segura-2

# CORS: lista de origens permitidas, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
